# Browser origin allowed to call this API. Separate multiple exact origins with commas.
ALLOWED_ORIGINS=https://courdemiracles.net

# Exactly 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
SESSION_SECRET=
SESSION_COOKIE_PREFIX=cdm_pixel
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Wallet which is allowed to administer the personal OpenSea profile.
ALLOWED_WALLET_ADDRESS=0x63cea00b2303d00d7ad60538353e162e81ca00dd
AUTH_CHAIN_ID=8453
AUTH_SESSION_MINUTES=10

# Store both values as Sensitive environment variables in Vercel.
OPENSEA_API_KEY=
OPENSEA_SCOPED_PAT=
OPENSEA_API_BASE_URL=https://api.opensea.io

# The PAT must contain exactly: write:drops and write:profile.
DROP_SLUG=pixel-sheet-editions-723927041
OPENSEA_CHAIN=base
OPENSEA_CONTRACT_ADDRESS=0x69680a053cdeda49e16291333d7995a5a04687da
OPENSEA_SHELF_TITLE=Pixel Sheet
OPENSEA_SHELF_DESCRIPTION=Works created with Pixel Sheet Converter.

# Local-only OpenSea mock. It is forcibly disabled on Vercel and in NODE_ENV=production.
OPENSEA_MOCK_MODE=false
